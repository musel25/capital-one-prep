{
  "id": "c1-29-etag-validation",
  "title": "29. Validate cached representations with ETags",
  "difficulty": "Medium",
  "link": "",
  "category": "03-apis-and-clients",
  "examples": [
    {
      "input": "{\"initial\": {\"version\": 1, \"body\": \"hello\"}, \"requests\": [{\"op\": \"get\", \"tags\": null}]}",
      "output": "[{\"status\": 200, \"etag\": \"\\\"v1\\\"\", \"body\": \"hello\"}]",
      "explanation": "No tag, so the API sends the body."
    },
    {
      "input": "{\"initial\": {\"version\": 1, \"body\": \"hello\"}, \"requests\": [{\"op\": \"get\", \"tags\": [\"\\\"v1\\\"\"]}]}",
      "output": "[{\"status\": 304, \"etag\": \"\\\"v1\\\"\", \"body\": null}]",
      "explanation": "The client's tag matches the current version: 304 with no body."
    },
    {
      "input": "{\"initial\": {\"version\": 1, \"body\": \"hello\"}, \"requests\": [{\"op\": \"put\", \"body\": \"new\"}, {\"op\": \"get\", \"tags\": [\"\\\"v1\\\"\"]}]}",
      "output": "[{\"status\": 200, \"etag\": \"\\\"v2\\\"\", \"body\": \"new\"}, {\"status\": 200, \"etag\": \"\\\"v2\\\"\", \"body\": \"new\"}]",
      "explanation": "After the update the version is 2, so the old tag `\"v1\"` does not match."
    }
  ],
  "starterCode": {
    "python": "def solve(data: dict) -> list:\n    raise NotImplementedError\n\n# Supplied CoJudge adapter. Implement solve(data) above.\nimport json\n\nclass Solution:\n    def run(self, payload: str) -> str:\n        return json.dumps(solve(json.loads(payload)), ensure_ascii=True, allow_nan=False)\n"
  },
  "testCases": [
    {
      "payload": "{\"initial\":{\"body\":\"hello\",\"version\":1},\"requests\":[{\"op\":\"get\",\"tags\":null}]}"
