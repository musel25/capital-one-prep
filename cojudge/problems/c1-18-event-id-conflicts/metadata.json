    {
      "payload": "{\"balance\":0,\"events\":[{\"delta\":2,\"id\":\"x\"},{\"delta\":3,\"id\":\"x\"},{\"delta\":2,\"id\":\"x\"}]}"
    },
    {
      "payload": "{\"balance\":8,\"events\":[]}"
    }
  ],
  "functionName": "run",
  "params": [
