      "explanation": "do not retry a client error"
    },
    {
      "input": "{\"outcomes\": [\"timeout\", 504], \"max_attempts\": 2, \"base\": 4, \"cap\": 20}",
      "output": "{\"attempts\": 2, \"delays\": [4], \"result\": \"exhausted\"}",
      "explanation": "no delay after final failure"
    }
  ],
