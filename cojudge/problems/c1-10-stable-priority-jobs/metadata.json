  "examples": [
    {
      "input": "{\"actions\": [{\"op\": \"add\", \"id\": \"slow\", \"priority\": 5}, {\"op\": \"add\", \"id\": \"fast\", \"priority\": 1}, {\"op\": \"pop\"}]}",
