      "input": "{\"stock\": 5, \"ops\": [{\"op\": \"reserve\", \"at\": 0, \"id\": \"a\", \"qty\": 2, \"ttl\": 5}, {\"op\": \"confirm\", \"at\": 5, \"id\": \"a\"}]}",
