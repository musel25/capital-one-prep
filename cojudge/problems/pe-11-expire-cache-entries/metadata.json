      "input": "{\"operations\": [{\"op\": \"put\", \"key\": \"a\", \"value\": null, \"now\": 0, \"ttl\": 1}, {\"op\": \"get\", \"key\": \"a\", \"now\": 0}, {\"op\": \"get\", \"key\": \"missing\", \"now\": 0}]}",
      "output": "[null, {\"hit\": true, \"value\": null}, {\"hit\": false, \"value\": null}]",
      "explanation": "cached null is distinct from a miss"
    }
  ],
  "starterCode": {
    "python": "def run_cache(operations):\n    raise NotImplementedError\n\n\n# Supplied CoJudge adapter. Implement run_cache above.\nclass Solution:\n    def run(self, payload: str) -> str:\n        import json\n        data = json.loads(payload)\n        before = json.dumps(data, sort_keys=True, ensure_ascii=True, allow_nan=False)\n        result = run_cache(**data)\n        if json.dumps(data, sort_keys=True, ensure_ascii=True, allow_nan=False) != before:\n            raise ValueError(\"Do not modify the input objects\")\n        return json.dumps(result, ensure_ascii=True, allow_nan=False)\n"
  },
