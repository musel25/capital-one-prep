      "input": "{\"operations\": [{\"op\": \"put\", \"key\": \"a\", \"value\": 9, \"now\": 5, \"ttl\": 3}, {\"op\": \"get\", \"key\": \"a\", \"now\": 8}]}",
      "output": "[null, {\"hit\": false, \"value\": null}]",
      "explanation": "entry expires exactly at its deadline"
    },
