[
  {
    "input": {
      "bodies": [
        {
          "account": "acct_1",
          "amount": 25
        }
      ]
    },
    "expected": [
      {
        "status": 201,
        "body": {
          "account": "acct_1",
          "amount": 25,
          "note": null
        }
      }
    ],
    "label": "valid body gets default null note"
  },
  {
    "input": {
      "bodies": [
        {
          "account": "A",
          "amount": 0,
          "note": false,
          "extra": 1
        }
      ]
    },
    "expected": [
      {
        "status": 422,
        "errors": [
          "account",
          "amount",
          "note",
          "unknown"
        ]
      }
    ],
    "label": "all field errors have fixed order"
  },
  {
    "input": {
      "bodies": [
        null
      ]
    },
    "expected": [
      {
        "status": 400,
        "errors": [
          "body"
        ]
      }
    ],
    "label": "JSON null is not an object"
  },
  {
    "input": {
      "bodies": []
    },
    "expected": [],
    "label": "empty batch"
  },
  {
    "input": {
      "bodies": [
        {}
      ]
    },
    "expected": [
      {
        "status": 422,
        "errors": [
          "account",
          "amount"
        ]
      }
    ],
    "label": "required fields absent"
  },
  {
    "input": {
      "bodies": [
        {
          "account": "a",
          "amount": true
        }
      ]
    },
    "expected": [
      {
        "status": 422,
        "errors": [
          "amount"
        ]
      }
    ],
    "label": "boolean is not an amount"
  },
  {
    "input": {
      "bodies": [
        {
          "account": "a",
          "amount": 1.0
        }
      ]
    },
    "expected": [
      {
        "status": 422,
        "errors": [
          "amount"
        ]
      }
    ],
    "label": "integral float is not an integer token"
  },
  {
    "input": {
      "bodies": [
        {
          "account": "a",
          "amount": 1.5
        }
      ]
    },
    "expected": [
      {
        "status": 422,
        "errors": [
          "amount"
        ]
      }
    ],
    "label": "fractional amount is rejected"
  },
