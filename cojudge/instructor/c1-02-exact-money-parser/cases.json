[
  {
    "input": {
      "amounts": [
        "12.34",
        "-0.05",
        "7"
      ]
    },
    "expected": {
      "cents": [
        1234,
        -5,
        700
      ]
    },
    "label": "exact decimal conversion"
  },
  {
    "input": {
      "amounts": [
        "1.234",
        " 2.00",
        2
      ]
    },
    "expected": {
      "cents": [
        null,
        null,
        null
      ]
    },
    "label": "invalid forms"
  },
  {
    "input": {
      "amounts": []
    },
    "expected": {
      "cents": []
    },
    "label": "empty input"
  },
  {
    "input": {
      "amounts": [
        "0",
        "-0",
        "-0.00"
      ]
    },
    "expected": {
      "cents": [
        0,
        0,
        0
      ]
    },
    "label": "signed zero"
  },
  {
    "input": {
      "amounts": [
        "1.2",
        "0.01"
      ]
    },
    "expected": {
      "cents": [
        120,
        1
      ]
    },
    "label": "one and two fractional digits"
  },
  {
    "input": {
      "amounts": [
        "0002.30",
        "00"
      ]
    },
    "expected": {
      "cents": [
        230,
        0
      ]
    },
    "label": "leading zeros"
  },
  {
    "input": {
      "amounts": [
        "+1",
        "1e2",
        "NaN",
        "Infinity"
      ]
    },
    "expected": {
      "cents": [
        null,
        null,
        null,
        null
      ]
    },
    "label": "decimal parser must be constrained"
  },
  {
    "input": {
      "amounts": [
        ".25",
        "2.",
        ""
      ]
    },
    "expected": {
      "cents": [
        null,
        null,
        null
      ]
    },
    "label": "missing required digits"
  },
  {
    "input": {
      "amounts": [
        null,
        true,
        false,
        1.5,
        {},
        []
      ]
    },
    "expected": {
      "cents": [
        null,
        null,
        null,
        null,
        null,
        null
      ]
    },
    "label": "wrong JSON types"
  },
  {
    "input": {
      "amounts": [
        "999999999999.99",
        "-999999999999.99"
      ]
    },
    "expected": {
      "cents": [
        99999999999999,
        -99999999999999
      ]
    },
    "label": "large exact values"
  },
  {
    "input": {
      "amounts": [
        "1\n",
        "1\t",
        "\u0661.\u0662\u0663"
      ]
    },
    "expected": {
      "cents": [
        null,
        null,
        null
      ]
    },
    "label": "whole ASCII string only"
  },
  {
    "input": {
      "amounts": [
        "0.29",
        "0.58",
        "-1.99"
      ]
    },
    "expected": {
      "cents": [
        29,
        58,
        -199
      ]
    },
    "label": "binary float traps"
  },
  {
    "input": {
      "amounts": [
        "--1",
        "1,00",
        "1 00"
      ]
    },
    "expected": {
      "cents": [
        null,
        null,
        null
      ]
    },
