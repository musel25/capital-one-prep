[
  {
    "input": {
      "initial": {
        "version": 1,
        "body": "hello"
      },
      "requests": [
        {
          "op": "get",
          "tags": null
        }
      ]
    },
    "expected": [
      {
        "status": 200,
        "etag": "\"v1\"",
        "body": "hello"
      }
    ],
    "label": "unconditional read returns representation"
  },
  {
    "input": {
      "initial": {
        "version": 1,
        "body": "hello"
      },
      "requests": [
        {
          "op": "get",
          "tags": [
            "\"v1\""
          ]
        }
      ]
    },
    "expected": [
      {
        "status": 304,
        "etag": "\"v1\"",
        "body": null
      }
    ],
    "label": "matching tag avoids body"
  },
  {
    "input": {
      "initial": {
        "version": 1,
        "body": "hello"
      },
      "requests": [
        {
          "op": "put",
          "body": "new"
        },
        {
          "op": "get",
          "tags": [
            "\"v1\""
          ]
        }
      ]
    },
    "expected": [
      {
        "status": 200,
        "etag": "\"v2\"",
        "body": "new"
      },
      {
        "status": 200,
        "etag": "\"v2\"",
        "body": "new"
      }
    ],
    "label": "write invalidates old validator"
  },
  {
    "input": {
      "initial": {
        "version": 1,
